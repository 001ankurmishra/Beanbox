# Server configuration
PORT=4000
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication (use a strong 32+ char secret in production)
JWT_SECRET=beanbox-dev-jwt-secret-change-in-production-32chars
JWT_EXPIRES_MINUTES=10080

# Payment Provider: "auto" (uses stripe if STRIPE_SECRET_KEY is set, otherwise mock), "stripe", or "mock"
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=beanbox-mock-webhook-secret-change-me

# Database Repository Backend: "auto" (uses supabase when DATABASE_URL is set, otherwise memory), "supabase", or "memory"
REPOSITORY_BACKEND=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
