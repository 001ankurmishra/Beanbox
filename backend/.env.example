# Server configuration
PORT=4000
APP_ENV=development
FRONTEND_URL=http://localhost:3000
# Number of trusted reverse proxies forwarding X-Forwarded-For (0 ignores XFF; N>0 uses Nth IP from the right)
TRUSTED_PROXY_COUNT=0
COOKIE_SECURE=auto

# Authentication (use strong 32+ char random secrets in production)
JWT_SECRET=beanbox-dev-jwt-secret-change-in-production-32chars
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_GRACE_SECONDS=10
TOTP_ENCRYPTION_KEY=

# Brute-force protection & per-endpoint sliding-window rate limits
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_BASE_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_VERIFY_RESEND_MAX=3
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_2FA_MAX=10

# Google OAuth 2.0 (Authorization Code + PKCE). Leave empty to disable Google sign-in gracefully.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Payment Provider: "auto" (uses stripe if STRIPE_SECRET_KEY is set, otherwise mock), "stripe", or "mock"
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=beanbox-mock-webhook-secret-change-me

# Database Repository Backend: "auto" (uses supabase when DATABASE_URL is set, otherwise memory), "supabase", or "memory"
REPOSITORY_BACKEND=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Redis Cache, Rate Limiter, Session Cache & Idempotency
# REDIS_ENABLED: "auto" (on when REDIS_URL reachable; off in APP_ENV=test unless REDIS_URL_TEST is set), "true", or "false"
# All Redis keys automatically use KEY_PREFIX="beanbox:{APP_ENV}:"
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=auto
